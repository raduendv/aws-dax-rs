{
  "package_version": "0.1.0",
  "native_library": "aws_dax_ffi",
  "phase8_native_targets": [
    "linux-x86_64",
    "linux-aarch64",
    "osx-x86_64",
    "osx-arm64",
    "windows-x86_64"
  ],
  "packaging_platforms": {
    "linux-x86_64": {
      "native_filename": "libaws_dax_ffi.so",
      "go_native_filename": "libaws_dax_ffi.so",
      "go_source": "native_linux_amd64.go",
      "go_build_constraint": "linux && amd64",
      "go_ldflags": "-L${SRCDIR}/native/linux-x86_64 -laws_dax_ffi -Wl,-rpath,${SRCDIR}/native/linux-x86_64",
      "dotnet_rid": "linux-x64",
      "python_wheel_tag": "manylinux_2_28_x86_64",
      "npm_os": "linux",
      "npm_cpu": "x64"
    },
    "linux-aarch64": {
      "native_filename": "libaws_dax_ffi.so",
      "go_native_filename": "libaws_dax_ffi.so",
      "go_source": "native_linux_arm64.go",
      "go_build_constraint": "linux && arm64",
      "go_ldflags": "-L${SRCDIR}/native/linux-aarch64 -laws_dax_ffi -Wl,-rpath,${SRCDIR}/native/linux-aarch64",
      "dotnet_rid": "linux-arm64",
      "python_wheel_tag": "manylinux_2_28_aarch64",
      "npm_os": "linux",
      "npm_cpu": "arm64"
    },
    "osx-x86_64": {
      "native_filename": "libaws_dax_ffi.dylib",
      "go_native_filename": "libaws_dax_ffi.a",
      "go_source": "native_darwin_amd64.go",
      "go_build_constraint": "darwin && amd64",
      "go_ldflags": "-L${SRCDIR}/native/osx-x86_64 -laws_dax_ffi -framework Security -framework CoreFoundation -framework SystemConfiguration",
      "dotnet_rid": "osx-x64",
      "python_wheel_tag": "macosx_10_12_x86_64",
      "npm_os": "darwin",
      "npm_cpu": "x64"
    },
    "osx-arm64": {
      "native_filename": "libaws_dax_ffi.dylib",
      "go_native_filename": "libaws_dax_ffi.a",
      "go_source": "native_darwin.go",
      "go_build_constraint": "darwin && arm64",
      "go_ldflags": "-L${SRCDIR}/native/osx-arm64 -laws_dax_ffi -framework Security -framework CoreFoundation -framework SystemConfiguration",
      "dotnet_rid": "osx-arm64",
      "python_wheel_tag": "macosx_11_0_arm64",
      "npm_os": "darwin",
      "npm_cpu": "arm64"
    },
    "windows-x86_64": {
      "native_filename": "aws_dax_ffi.dll",
      "go_native_filename": "libaws_dax_ffi.dll.a",
      "go_source": "native_windows_amd64.go",
      "go_build_constraint": "windows && amd64",
      "go_ldflags": "-L${SRCDIR}/native/windows-x86_64 -laws_dax_ffi",
      "dotnet_rid": "win-x64",
      "python_wheel_tag": "win_amd64",
      "npm_os": "win32",
      "npm_cpu": "x64"
    }
  },
  "java_baseline": 21,
  "dotnet_baseline": "net8.0",
  "javascript_backend": "@ubjs/node N-API",
  "unsupported_claims": [
    "Kotlin/Native",
    "Kotlin Multiplatform",
    "browser JavaScript",
    "WebAssembly JavaScript"
  ]
}
